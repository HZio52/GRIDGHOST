  "components": {
    "schemas": {
      "Belief": {
        "properties": {
          "slow": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Slow",
            "default": 0.3333333333333333
          },
          "neutral": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Neutral",
            "default": 0.3333333333333333
          },
          "fast": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Fast",
            "default": 0.3333333333333333
          },
          "updates": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Updates",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Belief"
      },
      "Candidate": {
        "properties": {
          "action": {
            "type": "string",
            "title": "Action"
          },
          "deploy_kw": {
            "type": "number",
            "title": "Deploy Kw"
          },
          "expected_energy_mj": {
            "type": "number",
            "title": "Expected Energy Mj"
          },
          "worst_case_energy_mj": {
            "type": "number",
            "title": "Worst Case Energy Mj"
          },
          "expected_gap_s": {
            "type": "number",
            "title": "Expected Gap S"
          },
          "gap_std_s": {
            "type": "number",
            "title": "Gap Std S"
          },
          "progress_s": {
            "type": "number",
            "title": "Progress S"
          },
          "score_s": {
            "type": "number",
            "title": "Score S"
          },
          "valid": {
            "type": "boolean",
            "title": "Valid"
          },
          "rejection_reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Rejection Reasons"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action",
          "deploy_kw",
          "expected_energy_mj",
          "worst_case_energy_mj",
          "expected_gap_s",
          "gap_std_s",
          "progress_s",
          "score_s",
          "valid",
          "rejection_reasons"
        ],
        "title": "Candidate"
      },
      "CompareRequest": {
        "properties": {
          "request": {
            "$ref": "#/components/schemas/PlanRequest"
          },
          "seed": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Seed",
            "default": 7
          },
          "ticks": {
            "type": "integer",
            "maximum": 30.0,
            "minimum": 3.0,
            "title": "Ticks",
            "default": 15
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request"
        ],
        "title": "CompareRequest"
      },
      "Decision": {
        "properties": {
          "recommendation": {
            "type": "string",
            "title": "Recommendation"
          },
          "status": {
            "type": "string",
            "enum": [
              "advisory",
              "abstain"
            ],
            "title": "Status"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/Candidate"
            },
            "type": "array",
            "title": "Candidates"
          },
          "belief": {
            "$ref": "#/components/schemas/Belief"
          },
          "score_margin_s": {
            "type": "number",
            "title": "Score Margin S"
          },
          "engine_latency_ms": {
            "type": "number",
            "title": "Engine Latency Ms"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version",
            "default": "demo-v1"
          },
          "constraints_status": {
            "type": "string",
            "title": "Constraints Status",
            "default": "model_policy; FIA rules not verified"
          },
          "uncertainty_label": {
            "type": "string",
            "title": "Uncertainty Label",
            "default": "scenario spread; not calibrated success probability"
          },
          "provenance": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Provenance"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "recommendation",
          "status",
          "reason",
          "candidates",
          "belief",
          "score_margin_s",
          "engine_latency_ms",
          "provenance"
        ],
        "title": "Decision"
      },
      "DecisionRequest": {
        "properties": {
          "state": {
            "$ref": "#/components/schemas/State"
          },
          "policy": {
            "$ref": "#/components/schemas/Policy"
          },
          "belief": {
            "$ref": "#/components/schemas/Belief"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "state"
        ],
        "title": "DecisionRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PlanRequest": {
        "properties": {
          "state": {
            "$ref": "#/components/schemas/State"
          },
          "policy": {
            "$ref": "#/components/schemas/Policy"
          },
          "belief": {
            "$ref": "#/components/schemas/Belief"
          },
          "planning": {
            "$ref": "#/components/schemas/Planning"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "state"
        ],
        "title": "PlanRequest"
      },
      "Planning": {
        "properties": {
          "stages": {
            "type": "integer",
            "maximum": 8.0,
            "minimum": 1.0,
            "title": "Stages",
            "default": 6
          },
          "stage_s": {
            "type": "number",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Stage S",
            "default": 4
          },
          "terminal_buffer_mj": {
            "type": "number",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Terminal Buffer Mj",
            "default": 0.25
          },
          "deployment_budget_mj": {
            "type": "number",
            "maximum": 20.0,
            "exclusiveMinimum": 0.0,
            "title": "Deployment Budget Mj",
            "default": 2.0
          },
          "attack_windows": {
            "items": {
              "type": "boolean"
            },
            "type": "array",
            "maxItems": 8,
            "minItems": 8,
            "title": "Attack Windows"
          },
          "switch_cost_s": {
            "type": "number",
            "maximum": 0.5,
            "minimum": 0.0,
            "title": "Switch Cost S",
            "default": 0.015
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Planning"
      },
      "Policy": {
        "properties": {
          "version": {
            "type": "string",
            "const": "demo-v1",
            "title": "Version",
            "default": "demo-v1"
          },
          "horizon_s": {
            "type": "number",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Horizon S",
            "default": 8
          },
          "step_s": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.1,
            "title": "Step S",
            "default": 0.5
          },
